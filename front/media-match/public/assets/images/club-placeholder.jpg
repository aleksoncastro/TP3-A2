<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400" role="img" aria-label="Imagem de clube indisponível">
  <defs>
    <linearGradient id="club-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1E1E1E"/>
      <stop offset="100%" stop-color="#141414"/>
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="url(#club-bg)"/>
  <g fill="#333" transform="translate(325,120)">
    <!-- Group icon -->
    <circle cx="75" cy="50" r="25" fill="#444"/>
    <ellipse cx="75" cy="110" rx="50" ry="30" fill="#444"/>
    <circle cx="30" cy="60" r="20" fill="#3A3A3A"/>
    <ellipse cx="30" cy="110" rx="40" ry="25" fill="#3A3A3A"/>
    <circle cx="120" cy="60" r="20" fill="#3A3A3A"/>
    <ellipse cx="120" cy="110" rx="40" ry="25" fill="#3A3A3A"/>
  </g>
  <text x="400" y="310" fill="#666" font-family="Montserrat, sans-serif" font-size="20" text-anchor="middle" font-weight="600">Imagem do clube indisponível</text>
</svg>
